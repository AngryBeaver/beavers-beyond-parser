<form class="bbp-form">

  <section class="bbp-section">
    <h3>Authentication</h3>
    <div class="form-group">
      <label>cobalt-token</label>
      <div class="form-fields">
        <input type="password" class="bbp-token-input" value="{{cobaltToken}}"
          placeholder="Paste your cobalt-token cookie value" />
        <button type="button" data-action="save-token">Save</button>
      </div>
      <p class="notes">
        D&amp;D Beyond → DevTools (F12) → Application → Cookies → dndbeyond.com → <strong>cobalt-token</strong>
      </p>
    </div>
  </section>

  <section class="bbp-section">
    <h3>Adventure URL</h3>
    <div class="form-group">
      <label>D&amp;D Beyond URL</label>
      <div class="form-fields">
        <input type="url" class="bbp-url-input"
          placeholder="https://www.dndbeyond.com/sources/dota/..." />
        <button type="button" data-action="fetch">Fetch</button>
      </div>
    </div>
  </section>

  <section class="bbp-section">
    <h3>Or paste page HTML</h3>
    <div class="form-group">
      <div class="form-fields bbp-paste-row">
        <textarea class="bbp-paste-area" rows="5"
          placeholder="If fetch is blocked by CORS, open the D&amp;D Beyond page → View Source (Ctrl+U) → select all → paste here."></textarea>
      </div>
      <div class="form-fields">
        <button type="button" data-action="parse-paste" class="bbp-full-btn">Parse pasted HTML</button>
      </div>
    </div>
  </section>

  <p class="bbp-status">—</p>

  {{#if parsed}}
  <section class="bbp-section bbp-preview">
    <h3>Preview — {{parsed.title}}</h3>
    {{#if parsed.description}}<p class="bbp-description">{{parsed.description}}</p>{{/if}}
    <ul class="bbp-chapter-list">
      {{#each parsed.chapters}}
      <li>
        <strong>{{this.title}}</strong>
        <span class="bbp-count">{{this.sections.length}} section(s)</span>
      </li>
      {{/each}}
    </ul>
    <button type="button" data-action="import" class="bbp-import-btn">
      <i class="fas fa-file-import"></i> Import to Foundry
    </button>
  </section>
  {{/if}}

</form>
