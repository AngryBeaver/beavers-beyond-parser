{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["dom", "esnext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": true,
    "noEmit": true,
    "types": ["jquery", "@league-of-foundry-developers/foundry-vtt-types"]
  },
  "include": ["src", "test"],
  "exclude": ["node_modules"]
}
