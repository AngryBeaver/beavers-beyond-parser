<form class="standard-form">

  {{#if proxyAvailable}}
  <div class="form-group">
    <label>D&amp;D Beyond Item URL</label>
    <input type="url" class="bbp-url-input"
      placeholder="https://www.dndbeyond.com/spells/2187-mending">
  </div>
  {{else}}
  <div class="bbp-info-box">
    <i class="fa-solid fa-circle-info"></i>
    To import by URL, start the proxy container on <code>{{proxyUrl}}</code>.
  </div>
  {{/if}}

  <div class="form-group">
    <label>Alternative:</label>
    <textarea class="bbp-paste-area" rows="8"
      placeholder="Paste D&amp;D Beyond stat block HTML here…"></textarea>
  </div>

  <p class="bbp-status">—</p>

  <button type="button" data-action="import" class="bbp-full-btn">
    <i class="fa-solid fa-hat-wizard"></i> Import Items
  </button>

</form>