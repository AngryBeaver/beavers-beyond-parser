<form class="bbp-form">

  <div class="form-group">
    <label>Stat Block HTML</label>
    <textarea class="bbp-paste-area" rows="7"
      placeholder="Paste D&amp;D Beyond stat block HTML containing spellcasting sections…"></textarea>
    <p class="notes">Spells are looked up in your compendiums. Any not found are created as world items.</p>
  </div>

  <div class="form-group">
    <label>Folder Name</label>
    <input type="text" class="bbp-folder-input bbp-full-input" value="Imported"
      placeholder="Imported">
    <p class="notes">World-item stubs go into Items → [Folder Name] → Spells.</p>
  </div>

  <p class="bbp-status">—</p>

  <button type="button" data-action="import" class="bbp-full-btn">
    <i class="fa-solid fa-hat-wizard"></i> Import Spells
  </button>

</form>
