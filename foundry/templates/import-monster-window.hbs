<form class="bbp-form">

  {{#if proxyAvailable}}
  <div class="form-group">
    <label>D&amp;D Beyond Monster URL</label>
    <input type="url" class="bbp-url-input"
      placeholder="https://www.dndbeyond.com/monsters/...">
  </div>
  {{else}}
  <div class="bbp-info-box">
    <i class="fa-solid fa-circle-info"></i>
    To import by URL, start the proxy container on <code>{{proxyUrl}}</code>.
  </div>
  {{/if}}

  {{#if aiEnabled}}
  <div class="bbp-ai-cost">
    <span class="bbp-ai-cost-label"><i class="fa-solid fa-robot"></i> AI cost estimate</span>
    <table class="bbp-cost-table">
      <thead><tr><th></th><th>Claude</th><th>Local</th></tr></thead>
      <tbody>
        {{#each costRows}}
        <tr><td>{{this.label}}</td><td>{{this.claude}}</td><td>{{this.local}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <p class="bbp-status">—</p>

  <button type="button" data-action="create" class="bbp-full-btn">
    <i class="fa-solid fa-dragon"></i> Import Monster
  </button>

</form>