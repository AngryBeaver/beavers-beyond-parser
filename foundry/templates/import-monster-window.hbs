<form class="standard-form">

  {{#if proxyAvailable}}
  <div class="form-group">
    <label>D&amp;D Beyond Monster URL</label>
    <input type="url" class="bbp-url-input"
      placeholder="https://www.dndbeyond.com/monsters/...">
  </div>
  {{else}}
  <div class="bbp-info-box">
    <i class="fa-solid fa-circle-info"></i>
    To import by URL, start the proxy container on <code>{{proxyUrl}}</code>.
  </div>
  {{/if}}

  {{#if aiCost}}
  <fieldset class="bbp-cost-estimate">
    <legend>AI Cost Estimate</legend>
    <table class="bbp-cost-table">
      <tbody>
        <tr><td class="bbp-cost-section" colspan="2">{{aiCost.perUnitHeader}}</td></tr>
        <tr>
          <td class="bbp-cost-label">Text input (all passes)</td>
          <td class="bbp-cost-value">{{aiCost.inputTokens}}</td>
        </tr>
        <tr>
          <td class="bbp-cost-label">Output (max, all passes)</td>
          <td class="bbp-cost-value">{{aiCost.outputTokens}}</td>
        </tr>
        <tr>
          <td class="bbp-cost-label">Cost per monster (Claude)</td>
          <td class="bbp-cost-value">{{aiCost.costPerUnit}}</td>
        </tr>
        {{#each aiCost.totals}}
        <tr><td class="bbp-cost-section" colspan="2">{{this.header}}</td></tr>
        <tr>
          <td class="bbp-cost-label">{{this.claudeModel}}</td>
          <td class="bbp-cost-value">
            {{this.claudeTotal}}
            <span class="bbp-cost-rate">({{this.claudeRate}})</span>
          </td>
        </tr>
        <tr>
          <td class="bbp-cost-label">LocalAI</td>
          <td class="bbp-cost-value">Free</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </fieldset>
  {{/if}}

  <p class="bbp-status">—</p>

  <button type="button" data-action="create" class="bbp-full-btn">
    <i class="fa-solid fa-dragon"></i> Import Monster
  </button>

</form>
